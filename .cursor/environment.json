{
  "name": "modelflow",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "python3.11 -m pip install --user -r backend/requirements.txt\ncd frontend && npm install",
  "start": "sudo service docker start",
  "ports": [
    { "name": "frontend", "port": 3000 },
    { "name": "fastapi", "port": 8000 },
    { "name": "react-dev", "port": 5173 },
    { "name": "postgres", "port": 5432 },
    { "name": "mlflow", "port": 5000 },
    { "name": "minio", "port": 9000 },
    { "name": "minio-console", "port": 9001 }
  ]
}
