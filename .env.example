# Generate a populated .env with ./scripts/init-env.sh.
# This template intentionally contains placeholders only. Empty required values
# are rejected by docker compose.
# Do not commit a real .env — keep local credentials and host ports private.

# Signs authentication tokens. Use at least 48 random bytes.
MODELFLOW_SECRET_KEY=

# Fernet key used to encrypt saved data-source secrets.
MODELFLOW_ENCRYPTION_KEY=

# Initial administrator identity, created only when the database has no users.
MODELFLOW_BOOTSTRAP_ADMIN_EMAIL=

# Initial administrator password. Change it immediately after first login.
MODELFLOW_BOOTSTRAP_ADMIN_PASSWORD=

# Primary PostgreSQL role, password, and application database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO root credentials used by ModelFlow and MLflow.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional postgres-source profile role, password, and database.
SOURCE_POSTGRES_USER=
SOURCE_POSTGRES_PASSWORD=
SOURCE_POSTGRES_DB=

# Host ports published by Docker Compose (container ports stay fixed).
# Change these in .env instead of editing docker-compose.yml.
POSTGRES_HOST_PORT=5432
SOURCE_POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MLFLOW_HOST_PORT=5000
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Public hostname used by Traefik deployments.
# Leave empty for local/non-Traefik development.
MODELFLOW_WEB_HOST=

# Comma-separated browser origins allowed to call the API.
# Include http://localhost:${FRONTEND_HOST_PORT} when you change the UI port.
# For Traefik production (.env.deploy), use https://${MODELFLOW_WEB_HOST}.
CORS_ORIGINS=

# API requests allowed per client IP per minute (raise for local verification gates).
RATE_LIMIT_PER_MINUTE=120

# Optional OpenAI-compatible LLM for Phase 7 Pipeline Copilot (backend only).
# Leave empty to disable Copilot; existing installs/CI boot without these.
MODELFLOW_LLM_BASE_URL=
MODELFLOW_LLM_API_KEY=
MODELFLOW_LLM_MODEL=
MODELFLOW_LLM_TIMEOUT_SECONDS=60

# Phase 8-A — Internal inference runtime service credential (server-owned).
# Never reuse MODELFLOW_SECRET_KEY or a user JWT. Generate via ./scripts/init-env.sh.
MODELFLOW_INFERENCE_SERVICE_TOKEN=
# Compose default; override only for non-Compose layouts.
MODELFLOW_INFERENCE_RUNTIME_URL=http://inference-runtime:8080
MODELFLOW_INFERENCE_TIMEOUT_SECONDS=60
MODELFLOW_INFERENCE_BATCH_CHUNK_SIZE=256

# Phase 8-C — Enterprise OIDC / SSO (backend only; disabled by default).
# When enabled, set issuer/client/redirect; client secret must never be sent to
# the frontend or worker containers.
MODELFLOW_OIDC_ENABLED=false
MODELFLOW_OIDC_ISSUER=
MODELFLOW_OIDC_CLIENT_ID=
MODELFLOW_OIDC_CLIENT_SECRET=
MODELFLOW_OIDC_REDIRECT_URI=
MODELFLOW_OIDC_DISPLAY_NAME=Company SSO
MODELFLOW_OIDC_SCOPES=openid profile email
MODELFLOW_OIDC_AUTO_PROVISION=false
