# Generate a populated .env with ./scripts/init-env.sh.
# This template intentionally contains placeholders only. Empty required values
# are rejected by docker compose.

# Signs authentication tokens. Use at least 48 random bytes.
MODELFLOW_SECRET_KEY=

# Fernet key used to encrypt saved data-source secrets.
MODELFLOW_ENCRYPTION_KEY=

# Initial administrator identity, created only when the database has no users.
MODELFLOW_BOOTSTRAP_ADMIN_EMAIL=

# Initial administrator password. Change it immediately after first login.
MODELFLOW_BOOTSTRAP_ADMIN_PASSWORD=

# Primary PostgreSQL role, password, and application database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO root credentials used by ModelFlow and MLflow.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional postgres-source profile role, password, and database.
SOURCE_POSTGRES_USER=
SOURCE_POSTGRES_PASSWORD=
SOURCE_POSTGRES_DB=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=
